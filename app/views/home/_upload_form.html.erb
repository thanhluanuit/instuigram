<div class="composer">
  <div class="composer-avatar">
    <% if current_user.avatar.attached? %>
      <%= image_tag current_user.avatar.variant(resize_to_fill: [ 76, 76 ]) %>
    <% else %>
      <i class="fa fa-user"></i>
    <% end %>
  </div>
  <div class="composer-main" data-controller="composer">
    <%= form_for Post.new, html: { class: "composer-form" } do |f| %>
      <%= f.label :description, "Caption", class: "visually-hidden" %>
      <%= f.text_field :description, class: 'composer-input', placeholder: "Write a caption... #hashtags welcome" %>

      <div class="composer-toolbar">
        <div class="composer-actions">
          <%= f.label :image, class: "composer-icon-btn", "aria-label": "Add a photo" do %>
            <i class="fa fa-camera"></i>
          <% end %>
          <%= f.file_field :image, class: 'visually-hidden', data: { composer_target: "fileInput", action: "change->composer#updateFilename" } %>
          <span class="composer-filename" data-composer-target="filename">No photo selected</span>
        </div>
        <%= f.submit 'Post', class: 'btn-accent', data: { composer_target: "submit" } %>
      </div>
    <% end %>
  </div>
</div>
