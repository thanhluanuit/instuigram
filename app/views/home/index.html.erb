<div class="classical-ds ig-page-with-aside">
  <div class="ig-feed-page">
    <div class="ig-composer-card" id="ig-composer">
      <%= render 'upload_form' %>
    </div>

    <% if @posts.any? %>
      <% @posts.each do |post| %>
        <%= render partial: 'post', locals: { post: post, user_reaction: @user_reactions[post.id] } %>
      <% end %>
      <div class="ig-pagination">
        <%= paginate @posts %>
      </div>
    <% else %>
      <div class="ig-empty-state">
        <p>No posts yet. Share your first photo above.</p>
      </div>
    <% end %>
  </div>

  <%= render "shared/discover_sidebar", trending_hash_tags: @trending_hash_tags, suggested_users: @suggested_users %>
</div>
