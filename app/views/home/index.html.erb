<% content_for :aside do %>
  <%= render "right_rail", suggestions: @suggestions %>
<% end %>

<div class="homepage">
  <div class='form-upload'>
    <%= render 'upload_form' %>
  </div>

  <% if @posts.load.any? %>
    <div class="posts" id="posts">
      <% @posts.each do |post| %>
        <%= render partial: 'post', locals: { post: post, user_reaction: @user_reactions[post.id], following: @following_ids.include?(post.user_id) } %>
      <% end %>
    </div>
    <%= render "feed_sentinel", posts: @posts %>
  <% else %>
    <div class="empty-state">
      <i class="fa fa-camera"></i>
      <p>No posts yet. Share your first photo above.</p>
    </div>
  <% end %>
</div>
