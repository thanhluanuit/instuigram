<section class="post">
  <div class="user">
    <%= render partial: "posts/user_header", locals: { user: post.user, following: following } %>
    <span class="post-overflow" aria-hidden="true"><i class="fa fa-ellipsis-h"></i></span>
  </div>
  <% cache post do %>
    <%= link_to post_path(post), class: 'main-image-link' do %>
      <%= image_tag post.image.variant(:feed), class: 'main-image' %>
    <% end %>
  <% end %>
  <div class="post-body">
    <div class="actions">
      <%= render partial: "posts/reaction_button", locals: { post: post, user_reaction: user_reaction, frame_id: dom_id(post, :reaction) } %>
      <%= render partial: "posts/comment_button", locals: { post: post } %>
      <span class="post-action" aria-hidden="true"><i class="fa fa-paper-plane-o"></i></span>
      <span class="post-action post-action--end" aria-hidden="true"><i class="fa fa-bookmark-o"></i></span>
    </div>
    <p class="description">
      <%= link_to post.user.username, user_path(post.user), class: "description-author" %>
      <%= render partial: "posts/description", locals: { post: post } %>
    </p>
    <%= link_to "View all comments", post_path(post), class: "post-comments-link", data: { turbo_frame: "post_modal" } %>
    <div class="post-comment">
      <div class="avatar">
        <%= render "users/avatar_image", user: current_user %>
      </div>
      <%= render partial: "comments/form", locals: { post: post, form_id_prefix: :feed_comment_form, comment: Comment.new } %>
    </div>
    <time class="post-time" datetime="<%= post.created_at.iso8601 %>"><%= time_ago_in_words(post.created_at) %> ago</time>
  </div>
</section>
