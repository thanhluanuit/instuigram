<div class="page-header">
  <h1 class="page-title">Settings</h1>
</div>

<div class="user-edit-page" data-controller="tabs">
  <div class="user-edit-page__nav">
    <%= render "users/settings_nav", active: :profile,
                                     placeholder_tabs: UsersHelper::SETTINGS_PLACEHOLDER_TABS %>
  </div>
  <div class="user-edit-page__pane tab-content">
    <div class="tab-pane fade show active" data-tabs-target="pane" id="v-pills-home" role="tabpanel" aria-labelledby="v-pills-home-tab">
      <%= form_with model: current_user, local: true, html: { class: "settings-form" } do |f| %>
        <%= render "users/form_identity", user: current_user %>

        <%= render "users/form_row",
                   label: f.label(:avatar, class: "settings-form__label"),
                   control: f.file_field(:avatar, class: "field") %>
        <%= render "users/form_row",
                   label: f.label(:name, class: "settings-form__label"),
                   control: f.text_field(:name, class: "field") %>
        <%= render "users/form_row",
                   label: f.label(:username, class: "settings-form__label"),
                   control: f.text_field(:username, class: "field") %>
        <%= render "users/form_row",
                   label: f.label(:website, class: "settings-form__label"),
                   control: f.text_field(:website, class: "field") %>
        <%= render "users/form_row",
                   label: f.label(:bio, class: "settings-form__label"),
                   control: f.text_area(:bio, class: "field", rows: 3) %>
        <%= render "users/form_row",
                   label: f.label(:email, class: "settings-form__label"),
                   control: f.text_field(:email, class: "field") %>
        <%= render "users/form_row",
                   label: f.label(:phone, class: "settings-form__label"),
                   control: f.text_field(:phone, class: "field") %>
        <%= render "users/form_row",
                   label: f.label(:gender, class: "settings-form__label"),
                   control: f.text_field(:gender, class: "field") %>

        <div class="settings-form__actions">
          <%= f.submit "Save changes", class: "btn-accent" %>
        </div>
      <% end %>
    </div>
    <% UsersHelper::SETTINGS_PLACEHOLDER_TABS.each do |label, anchor| %>
      <div class="tab-pane fade" data-tabs-target="pane" id="<%= anchor %>" role="tabpanel">
        <p class="settings-form__placeholder"><%= label %> — coming soon.</p>
      </div>
    <% end %>
  </div>
</div>
