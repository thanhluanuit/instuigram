<%= turbo_stream_from @user, :follows %>

<div class="user-profile">
  <div class="profile row">
    <div class="col-md-4 avatar">
      <div class="wrapper">
        <% if @user.avatar.attached? %>
          <%= image_tag @user.avatar.variant(resize_to_fill: [ 280, 280 ]) %>
        <%end %>
      </div>
    </div>
    <div class="col-md-8 basic-info">
      <div class="user-wrapper">
        <h2 class="username"><%= @user.username %></h2>
        <% if @user == current_user %>
          <a class="edit-profile" href="<%= edit_user_path(@user) %>">
            <button>Edit Profile</button>
          </a>
        <% elsif user_signed_in? %>
          <%= render "users/follow_button", user: @user, following: current_user.following?(@user) %>
          <%= button_to "Message", conversations_path, params: { user_id: @user.id }, class: "message-user" %>
        <% end %>
      </div>
      <ul class="posts">
        <li><span><%= @posts.total_count %></span> posts</li>
        <%= render "users/followers_count", user: @user %>
        <%= render "users/following_count", user: @user %>
      </ul>
      <h2 class="name"><%=@user.name %></h2>
      <%= link_to @user.website, external_url(@user.website), class: 'website' %>
    </div>
  </div>

  <div class="user-tabs">
    <a class="tab active" href="">
      <i class="fa fa-th"></i>
      POSTS
    </a>
    <a class="tab" href="">
      <i class="fa fa-tv"></i>
      IGTV
    </a>
    <a class="tab" href="">
      <i class="fa fa-bookmark"></i>
      SAVED
    </a>
    <a class="tab" href="">
      <i class="fa fa-tag"></i>
      TAGGED
    </a>
  </div>

  <%= render partial: "posts/thumbnail_grid", locals: { posts: @posts } %>
</div>
