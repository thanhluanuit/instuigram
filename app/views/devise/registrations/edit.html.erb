<div class="page-header">
  <h1 class="page-title">Settings</h1>
</div>

<div class="user-edit-page">
  <div class="user-edit-page__nav">
    <%= render "users/settings_nav", active: :password %>
  </div>

  <div class="user-edit-page__pane">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "settings-form" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <%= render "users/form_identity", user: current_user %>

      <%= render "users/form_row", f: f, attribute: :current_password, label: "Old Password",
                 control: f.password_field(:current_password, autocomplete: "current-password", class: "field") %>
      <%= render "users/form_row", f: f, attribute: :password, label: "New Password",
                 control: f.password_field(:password, autocomplete: "new-password", class: "field"),
                 hint: "At least #{@minimum_password_length} characters." %>
      <%= render "users/form_row", f: f, attribute: :password_confirmation, label: "Confirm New Password",
                 control: f.password_field(:password_confirmation, autocomplete: "new-password", class: "field") %>

      <div class="settings-form__actions">
        <%= f.submit "Change Password", class: "btn-accent" %>
      </div>
    <% end %>
  </div>
</div>
