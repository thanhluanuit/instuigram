<div class="search-page">
  <% if @posts.any? %>
    <h1>Top Posts</h1>
  <% else %>
    <h1>Oop! No matching posts ...</h1>
  <% end %>

  <div class="user-images">
    <% @posts.each do |post|%>
      <div class="wrapper">
        <%=link_to post_path(post) do %>
          <%=image_tag post.image.variant(resize_to_fill: [ 293, 293 ]), loading: "lazy" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%= paginate @posts %>
</div>
