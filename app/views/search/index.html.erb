<div class="search-page">
  <% if @posts.any? %>
    <div class="page-header">
      <h1 class="page-title">Top posts</h1>
      <p class="page-subtitle"><%= pluralize(@posts.total_count, "result") %> for <%= params[:query] %></p>
    </div>
    <%= render partial: "posts/thumbnail_grid", locals: { posts: @posts } %>
  <% else %>
    <div class="empty-state">
      <i class="fa fa-search"></i>
      <p>No posts match <%= params[:query].presence || "that search" %>. Try another word or a #hashtag.</p>
    </div>
  <% end %>
</div>
