<div class="aside-panel aside-hashtags">
  <span class="aside-panel__title">Trending hashtags</span>
  <ul class="aside-hashtags__list">
    <% hashtags.each do |hashtag| %>
      <li>
        <%= link_to "##{hashtag.name}", search_path(query: "##{hashtag.name}"), class: "aside-hashtags__link" %>
      </li>
    <% end %>
  </ul>
</div>
