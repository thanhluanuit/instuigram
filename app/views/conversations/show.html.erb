<% other = @conversation.other_participant(current_user) %>
<section class="chat"
         data-controller="conversation"
         data-conversation-conversation-id-value="<%= @conversation.id %>"
         data-conversation-current-user-id-value="<%= current_user.id %>"
         data-conversation-read-url-value="<%= conversation_read_path(@conversation) %>">
  <header class="chat__header">
    <%= link_to conversations_path, class: "chat__back" do %>&larr;<% end %>

    <div class="chat__avatar">
      <% if other&.avatar&.attached? %>
        <%= image_tag other.avatar.variant(resize_to_fill: [ 40, 40 ]) %>
      <% end %>
      <span class="presence-dot <%= "is-online" if other&.online? %>" data-presence-user-id="<%= other&.id %>"></span>
    </div>

    <div class="chat__identity">
      <%= link_to other&.username, other ? user_path(other) : "#", class: "chat__name" %>
      <span class="chat__presence" data-presence-status-for="<%= other&.id %>">
        <%= other&.online? ? "Active now" : "Offline" %>
      </span>
    </div>
  </header>

  <div id="<%= dom_id(@conversation, :messages) %>"
       class="chat__messages"
       data-conversation-target="list">
    <%= render partial: "messages/message", collection: @messages, as: :message %>
  </div>

  <%= form_with model: Message.new,
                url: conversation_messages_path(@conversation),
                class: "chat__composer",
                data: { action: "turbo:submit-end->conversation#clearComposer" } do |form| %>
    <%= form.text_field :body,
                        placeholder: "Message...",
                        autocomplete: "off",
                        class: "chat__input",
                        data: { conversation_target: "input" } %>
    <%= form.submit "Send", class: "chat__send" %>
  <% end %>
</section>
