<section class="conversations">
  <div class="page-header">
    <h1 class="page-title">Messages</h1>
    <%= link_to "New message", new_conversation_path, class: "btn-outline" %>
  </div>

  <% if @conversations.any? %>
    <div class="conversations__list">
      <%= render partial: "conversations/conversation", collection: @conversations, as: :conversation %>
    </div>
    <%= paginate @conversations %>
  <% else %>
    <div class="empty-state">
      <i class="fa fa-paper-plane-o"></i>
      <p>No messages yet. Start a <%= link_to "new message", new_conversation_path %>.</p>
    </div>
  <% end %>
</section>
