<section class="conversations">
  <div class="page-header">
    <h1 class="page-title">New message</h1>
  </div>

  <%= form_with url: new_conversation_path, method: :get, class: "conversations__search" do |form| %>
    <%= form.label :query, "Search by username", class: "visually-hidden" %>
    <%= form.text_field :query, value: params[:query], placeholder: "Search by username...", class: "field-pill" %>
  <% end %>

  <% if @users.any? %>
    <div class="conversations__list">
      <% @users.each do |user| %>
        <div class="conversation-row">
          <%= link_to user_path(user), class: "conversation-row__avatar" do %>
            <%= render "users/avatar_with_presence", user: user %>
          <% end %>

          <div class="conversation-row__body">
            <%= link_to user.username, user_path(user), class: "conversation-row__name" %>
            <span class="conversation-row__preview"><%= user.name %></span>
          </div>

          <%= button_to "Message", conversations_path, params: { user_id: user.id }, class: "btn-outline" %>
        </div>
      <% end %>
    </div>
    <%= paginate @users %>
  <% else %>
    <div class="empty-state">
      <i class="fa fa-user-o"></i>
      <p>No users found. Try a different username.</p>
    </div>
  <% end %>
</section>
