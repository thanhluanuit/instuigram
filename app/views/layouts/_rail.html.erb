<nav class="app-rail" aria-label="Primary">
  <%= link_to root_path, nav_rail_link_options(:home) do %>
    <i class="fa fa-home"></i>
    Home
  <% end %>
  <%= link_to conversations_path, nav_rail_link_options(:messages) do %>
    <i class="fa fa-paper-plane-o"></i>
    Messages
  <% end %>
  <% ApplicationHelper::NAV_RAIL_PLACEHOLDERS.each do |label, icon| %>
    <span class="app-rail__item app-rail__item--inert" aria-hidden="true">
      <i class="fa fa-<%= icon %>"></i>
      <%= label %>
    </span>
  <% end %>
  <%= link_to user_path(current_user), nav_rail_link_options(:profile) do %>
    <span class="app-rail__avatar">
      <%= render "users/avatar_image", user: current_user, loading: "lazy" %>
    </span>
    Profile
  <% end %>
  <%= link_to "New post", root_path(anchor: "post_description"), class: "btn-accent btn-block app-rail__new" %>
</nav>
