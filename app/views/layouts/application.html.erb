<!DOCTYPE html>
<html>
  <head>
    <title>Instagram</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600&family=Lora:wght@400;600&display=swap">
    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbo-track': 'reload' %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <!--Top bar: brand, search, auth — present at every breakpoint-->
    <nav class="classical-ds ig-topbar">
      <div class="ig-topbar-inner">
        <%= link_to "Instuigram", root_path, class: "ig-topbar-brand" %>
        <%= form_with url: search_path, method: :get, local: true, class: 'ig-topbar-search' do |form| %>
          <%= form.text_field :query, value: params[:query], class: 'ig-input', placeholder: 'Search posts and #tags' %>
        <% end %>
        <div class="ig-topbar-auth">
          <% if user_signed_in? %>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "ig-btn ig-btn-ghost" %>
          <% else %>
            <%= link_to "Sign in", new_user_session_path, class: "ig-btn ig-btn-primary" %>
          <% end %>
        </div>
      </div>
    </nav>

    <div class="classical-ds ig-shell">
      <% if user_signed_in? %>
        <!--Left rail: primary navigation, desktop only (collapses to the bottom tab bar below)-->
        <aside class="ig-rail">
          <nav class="ig-rail-nav" aria-label="Primary">
            <%= link_to root_path, class: class_names("ig-rail-link", "is-active" => nav_active?("home")) do %>
              <svg width="16" height="16" viewBox="0 0 20 20" fill="none"><path d="M3 9l7-6 7 6v8H3V9z" stroke="currentColor" stroke-width="1.3"></path></svg>Feed
            <% end %>
            <%= link_to search_path, class: class_names("ig-rail-link", "is-active" => nav_active?("search")) do %>
              <svg width="16" height="16" viewBox="0 0 20 20" fill="none"><circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.3"></circle><path d="M13.5 13.5L18 18" stroke="currentColor" stroke-width="1.3"></path></svg>Explore
            <% end %>
            <%= link_to user_path(current_user), class: class_names("ig-rail-link", "is-active" => nav_active?("users")) do %>
              <svg width="16" height="16" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="7" r="3.2" stroke="currentColor" stroke-width="1.3"></circle><path d="M4 17c1.4-3 3.4-4.4 6-4.4s4.6 1.4 6 4.4" stroke="currentColor" stroke-width="1.3"></path></svg>Profile
            <% end %>
          </nav>
          <%= link_to "Compose", root_path(anchor: "ig-composer"), class: "ig-btn ig-btn-primary ig-rail-compose" %>
        </aside>
      <% end %>

      <!--Main content-->
      <main class="container main-content">
        <% flash.each do |type, message| %>
          <div class="alert alert-<%= type == "alert" ? "danger" : "success" %>"><%= message %></div>
        <% end %>
        <%= yield %>
      </main>
    </div>

    <% if user_signed_in? %>
      <!--Bottom tab bar: primary navigation, mobile only-->
      <nav class="classical-ds ig-tabbar" aria-label="Primary">
        <%= link_to root_path, class: class_names("ig-tab", "is-active" => nav_active?("home")), "aria-label": "Feed" do %>
          <svg width="22" height="22" viewBox="0 0 20 20" fill="none"><path d="M3 9l7-6 7 6v8H3V9z" stroke="currentColor" stroke-width="1.3"></path></svg>
        <% end %>
        <%= link_to search_path, class: class_names("ig-tab", "is-active" => nav_active?("search")), "aria-label": "Explore" do %>
          <svg width="22" height="22" viewBox="0 0 20 20" fill="none"><circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.3"></circle><path d="M13.5 13.5L18 18" stroke="currentColor" stroke-width="1.3"></path></svg>
        <% end %>
        <%= link_to user_path(current_user), class: class_names("ig-tab", "is-active" => nav_active?("users")), "aria-label": "Profile" do %>
          <svg width="22" height="22" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="7" r="3.2" stroke="currentColor" stroke-width="1.3"></circle><path d="M4 17c1.4-3 3.4-4.4 6-4.4s4.6 1.4 6 4.4" stroke="currentColor" stroke-width="1.3"></path></svg>
        <% end %>
      </nav>
    <% end %>

    <!--Footer-->
    <footer class="container footer">
      <nav class="navbar d-flex">
        <ul>
          <li>ABOUT US
          </li>
          <li>SUPPORT</li>
          <li>PRESS</li>
          <li>API</li>
          <li>JOBS</li>
          <li>PRIVACY</li>
          <li>TERMS</li>
          <li>DIRECTORY</li>
          <li>PROFILES</li>
          <li>HASHTAGS</li>
          <li>LANGUAGE</li>
        </ul>
        <p> © 2018 INSTAGRAM </p>
      </nav>
    </footer>
  </body>
</html>
