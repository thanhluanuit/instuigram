<!DOCTYPE html>
<html>
  <head>
    <title>Instagram</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbo-track': 'reload' %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if user_signed_in? %>
      <div id="realtime" data-turbo-permanent data-controller="inbox presence"></div>
    <% end %>

    <!--Navigation Bar-->
    <nav class="navbar">
      <div class="container">
        <div class="logo">
          <a class="navbar-brand" href="<%= root_path %>">
            <%= fa_stacked_icon "camera inverse", base: "circle"%>
            Instagram
          </a>
        </div>
        <%= form_with url: search_path, method: :get, local: true, class: 'navbar-search' do |form| %>
          <%= form.label :query, "Search posts", class: "visually-hidden" %>
          <%= form.text_field :query, value: params[:query], class: 'field-pill', placeholder: 'Search posts and hashtags' %>
        <% end %>
        <div class="user-section">
          <% if user_signed_in? %>
            <% unread = current_user.unread_messages_count %>
            <a href="<%= conversations_path %>" class="messages-link">
              <i class="fa fa-paper-plane"></i>
              <span id="unread-badge" class="unread-badge <%= "is-hidden" if unread.zero? %>"><%= unread %></span>
            </a>
            <a href="<%= user_path(current_user)%>">
              <i class="fa fa-user"></i>
            </a>
          <% else %>
            <a href="<%= new_user_session_path%>">
              <i class="fa fa-sign-in"></i>
            </a>
          <% end %>
        </div>
      </div>
    </nav>

    <!--Main content-->
    <main class="container main-content">
      <% flash.each do |type, message| %>
        <div class="alert alert-<%= type == "alert" ? "danger" : "success" %>"><%= message %></div>
      <% end %>
      <%= yield %>
    </main>

    <!--Footer-->
    <%= render "layouts/footer" %>

    <%= turbo_frame_tag "post_modal" %>
  </body>
</html>
