<div class="aside-panel aside-author">
  <span class="aside-panel__title">Posted by</span>
  <div class="aside-author__row">
    <div class="avatar">
      <%= link_to user_path(user) do %>
        <%= render "users/avatar_image", user: user %>
      <% end %>
    </div>
    <div class="aside-author__identity">
      <%= link_to user.username, user_path(user), class: "aside-suggestion__name" %>
      <span class="aside-suggestion__meta"><%= pluralize(user.followers_count, "follower") %></span>
    </div>
  </div>
  <% if user != current_user %>
    <%= render "users/follow_button", user: user, following: current_user.following?(user) %>
  <% end %>
</div>
