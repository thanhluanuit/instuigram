<div class="post-detail">
  <div class="post-detail__media">
    <%= image_tag post.image.variant(:detail), class: 'post-detail__image', alt: "" %>
  </div>
  <div class="post-detail__panel">
    <div class="user">
      <%= render partial: "posts/user_header", locals: { user: post.user, avatar_size: 88, following: current_user&.following?(post.user) } %>
    </div>
    <div class="description">
      <%= render partial: "posts/description", locals: { post: post } %>
    </div>
    <div class="actions">
      <%= render partial: "posts/reaction_button", locals: { post: post, user_reaction: user_reaction, frame_id: reaction_frame_id } %>
      <% if current_user && current_user.id == post.user_id %>
        <%= link_to post_path(post), data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: "delete-icon", "aria-label": "Delete post" do %>
          <i class="fa fa-trash-o"></i>
        <% end %>
      <% end %>
    </div>
    <%= render partial: "comments/list", locals: { post: post } %>
    <% if current_user %>
      <%= render partial: "comments/form", locals: { post: post, form_id_prefix: :comment_form, comment: Comment.new } %>
    <% end %>
  </div>
</div>
