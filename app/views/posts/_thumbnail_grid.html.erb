<% if posts.load.any? %>
  <div class="thumbnail-grid">
    <% posts.each do |post| %>
      <div class="wrapper">
        <%= link_to post_path(post) do %>
          <%= image_tag post.image.variant(:thumb), loading: "lazy", alt: "" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%= paginate posts %>
<% else %>
  <div class="empty-state">
    <i class="fa fa-<%= local_assigns.fetch(:empty_icon, "camera") %>"></i>
    <p><%= local_assigns.fetch(:empty_message, "No posts yet.") %></p>
  </div>
<% end %>
