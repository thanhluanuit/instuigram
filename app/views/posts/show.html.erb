<div class="post-show row">
  <div class="col-md-8">
    <%=image_tag @post.image, class: 'image' %>
  </div>
  <div class="col-md-4">
    <div class="user">
      <div class="avatar">
        <% if @post.user.avatar.attached? %>
          <%= link_to user_path(@post.user) do %>
            <%= image_tag @post.user.avatar %>
          <% end %>
        <% end %>
      </div>
      <%= link_to @post.user.username, user_path(@post.user), class: 'username' %>
    </div>
    <div class="description">
      <%= render partial: "description", locals: {post: @post} %>
    </div>
    <div class="actions">
      <%= render partial: "reaction_button", locals: { post: @post, user_reaction: @user_reaction } %>
      <% if current_user&.posts&.exists?(@post.id) %>
        <div class="delete">
          <%= link_to post_path(@post), data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: "delete-icon", "aria-label": "Delete" do %>
            <i class="fa fa-trash-o"></i>
          <% end %>
        </div>
      <% end %>
    </div>
    <div class="comments">
      <% if @post.comments.any? %>
        <% @post.comments.each do |comment| %>
          <%= render partial: "comments/comment", locals: { comment: comment } %>
        <% end %>
      <% else %>
        <p class="no-comments">No comments yet.</p>
      <% end %>
    </div>
    <% if current_user %>
      <div class="comment-form">
        <%= render partial: "comments/form", locals: { post: @post } %>
      </div>
    <% end %>
  </div>
</div>
